# 16. Secrets management: Keep database credentials and JWT signing secrets in
# environment variables instead of hard-coding them in application source code.
# SECRETs management

# Server port
PORT=3000

# PostgreSQL connection
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# JWT secrets
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret